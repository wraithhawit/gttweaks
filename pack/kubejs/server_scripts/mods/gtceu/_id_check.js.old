function gttweaksIdExists(id) {
    let rl = $ResourceLocation.parse(id)
    return $BuiltInRegistries.ITEM.containsKey(rl) || $BuiltInRegistries.FLUID.containsKey(rl)
}

function gttweaksTagSize(tag) {
    let holders = $BuiltInRegistries.ITEM.getTag($TagKey.create($Registries.ITEM, $ResourceLocation.parse(tag)))
    return holders.isPresent() ? holders.get().size() : 0
}

ServerEvents.recipes(event => {
    if (gttweaksIdExists(CANARY)) {
        console.error('[id-check] BROKEN - the canary id resolved, so this check proves nothing')
    } else {
        let missing = []
        IDS.forEach(id => { if (!gttweaksIdExists(id)) missing.push(id) })
        if (missing.length == 0) {
            console.info('[id-check] all ' + IDS.length + ' ids resolve')
        } else {
            console.error('[id-check] ' + missing.length + ' of ' + IDS.length + ' ids do not exist:')
            missing.forEach(id => console.error('[id-check]   ' + id))
        }
    }

    if (gttweaksTagSize(CANARY_TAG) == 0) {
        console.warn('[tag-check] skipped - item tags are not bound yet at this point in the reload')
        return
    }
    let empty = []
    TAGS.forEach(tag => { if (gttweaksTagSize(tag) == 0) empty.push(tag) })
    if (empty.length == 0) {
        console.info('[tag-check] all ' + TAGS.length + ' tags have members')
    } else {
        console.error('[tag-check] ' + empty.length + ' of ' + TAGS.length + ' tags are EMPTY - recipes using them register fine and can never be crafted:')
        empty.forEach(tag => console.error('[tag-check]   #' + tag))
    }
})
